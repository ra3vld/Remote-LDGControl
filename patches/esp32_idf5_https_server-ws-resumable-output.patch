+int HTTPConnection::writeSome(byte* buffer, size_t length) {
+  if (isClosed()) return -1;
+  // Preserve encryption for the optional HTTPS transport. Plain HTTP never
+  // waits here: the WebSocket owns the unsent tail across loop iterations.
+  if (isSecure()) {
+    const size_t count = writeBuffer(buffer, length);
+    return count <= length ? int(count) : -1;
+  }
+  if (heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) < 16384 ||
+      heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) < 4096)
+    return 0;
+  const size_t allowance = httpSendAllowance(_socket);
+  if (!allowance) return 0;
+  const int count = send(_socket, buffer, length < allowance ? length : allowance, MSG_DONTWAIT);
+  if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR || errno == ENOMEM || errno == ENOBUFS))
+    return 0;
+  return count > 0 ? count : -1;
 }
 
